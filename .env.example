# ==============================================================================
# LIGHT FORGE — Server Environment Variables (.env.example)
# ==============================================================================
# 1. Скопируйте этот файл в `.env.local` рядом с package.json:
#      copy .env.example .env.local
# 2. Вставьте ваш реальный ключ в GEMINI_API_KEY внутри `.env.local`.
# 3. НИКОГДА не коммитьте `.env.local` в Git (защищено в .gitignore) и
#    НИКОГДА не отправляйте секретный ключ в чат или клиентский код.
# ==============================================================================

# Секретный ключ Google Gemini API (Google AI Studio -> Get API key).
# Используется ТОЛЬКО на сервере Next.js.
GEMINI_API_KEY=

# Необязательно: явный выбор конкретной Flash-модели (должна быть доступна
# вашему ключу и поддерживать изображения/PDF и структурированный JSON).
# Если оставить пустым, сервер выберет первую доступную бесплатную Flash-модель
# из LIGHT_FORGE_GEMINI_FREE_MODELS (предпочитая gemini-3.8-flash).
GEMINI_MODEL=

# Разрешённые модели для бесплатного тарифа (Free Tier), в порядке приоритета.
# Платные модели (Pro / Gemini 4) и автоматический биллинг отключены.
LIGHT_FORGE_GEMINI_FREE_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash

# Явное подтверждение, что проект в Google AI Studio используется на Free Tier (1 = да).
LIGHT_FORGE_GEMINI_FREE_PROJECT=1

# Защитные лимиты приложения (дневной и месячный) для бесплатного тарифа.
LIGHT_FORGE_GEMINI_DAILY_LIMIT=20
LIGHT_FORGE_GEMINI_MONTHLY_LIMIT=400
